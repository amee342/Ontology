<owl:Class rdf:about="Actor">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasDecisionRole"/>
      <owl:allValuesFrom rdf:resource="DecisionRole"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <core:closeMatch rdf:resource="https://www.wikidata.org/entity/Q33999"/>
  <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Agent_(grammar)"/>
</owl:Class>

<owl:Class rdf:about="Capability">
