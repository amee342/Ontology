<owl:Class rdf:about="Interaction">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasTrustLevel"/>
      <owl:allValuesFrom rdf:resource="TrustLevel"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasCoordinationPattern"/>
      <owl:allValuesFrom rdf:resource="CoordinationPattern"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="interactingAgent"/>
      <owl:onClass rdf:resource="Actor"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Interaction"/>
  <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Human-computer_interaction"/>
</owl:Class>

