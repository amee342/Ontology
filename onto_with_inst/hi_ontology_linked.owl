</owl:Class>

<owl:Class rdf:about="DecisionParticipant">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="Human"/>
        <rdf:Description rdf:about="ArtificialAgent"/>
      </owl:unionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="HighTrustInteraction">
  <rdfs:subClassOf rdf:resource="Interaction"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="Interaction"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="hasTrustLevel"/>
          <owl:someValuesFrom rdf:resource="HighTrust"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="SupervisedAIAgent">
  <rdfs:subClassOf rdf:resource="ArtificialAgent"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="ArtificialAgent"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="subjectToControlMode"/>
          <owl:someValuesFrom rdf:resource="HumanOnTheLoop"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

