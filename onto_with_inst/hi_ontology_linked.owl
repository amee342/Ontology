<owl:Class rdf:about="ArtificialAgent">
  <rdfs:subClassOf rdf:resource="Actor"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="hasAutonomyLevel"/>
      <owl:onClass rdf:resource="AutonomyLevel"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <core:closeMatch rdf:resource="https://www.wikidata.org/entity/Q1142726"/>
  <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Intelligent_agent"/>
  <core:closeMatch rdf:resource="http://dbpedia.org/resource/Software_agent"/>
